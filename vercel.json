{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/uploads/:filename",
      "destination": "https://the-product-zone-api.onrender.com/uploads/:filename"
    },
    {
      "source": "/api/:path*",
      "destination": "https://the-product-zone-api.onrender.com/api/:path*"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}